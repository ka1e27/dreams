	(footprint "dreams_v3:RaspberryPi_Pico_Socketed_THT"
		(layer "B.Cu")
		(uuid "7fe07737-9556-4c24-ac59-f4dafbb0badc")
		(at 73.8 91)
		(descr "Raspberry Pi Pico / Pico 2, socketed on two 1x20 female headers (8.5 mm). Same pads, outline and 3D models as RaspberryPi_Pico_Common_THT, but the courtyard covers only the two socket rows and the USB end, so flat parts may sit under the module: keep them under ~7 mm tall. The micro-USB receptacle outline is on F.Fab only, so pads may sit under it. 3D: the 8.5 mm sockets with a Pico H seated in them. D.R.E.A.M.S V3.1, 2026-10-10.")
		(tags "module usb pcb antenna")
		(property "Reference" "U1"
			(at 8.89 -42.4 0)
			(unlocked yes)
			(layer "B.SilkS")
			(uuid "06d3a887-23a2-4031-b66f-194773bef148")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
				(justify left mirror)
			)
		)
		(property "Value" "Raspberry Pi Pico 2"
			(at 8.89 -52.07 180)
			(unlocked yes)
			(layer "B.Fab")
			(uuid "5a87b912-f9d5-4727-ac31-adc42ff2bdf4")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
				(justify mirror)
			)
		)
		(property "Datasheet" ""
			(at 8.89 -24.13 180)
			(layer "B.Fab")
			(hide yes)
			(uuid "138c149c-9e8f-47c3-ae20-157d197a3bfe")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
				(justify mirror)
			)
		)
		(property "Description" "Pico A, control MCU: Raspberry Pi Pico 2 (RP2350) on two 1x20 sockets under the carrier, C++ (Arduino-Pico or the Pico SDK), USB cable to the Pi. GP0 winch ESC PWM, GP1 SBUS (UART0 RX, invert in the GPIO block), GP2-GP8 A4988 (DIR, STEP, SLEEP, MS3, MS2, MS1, EN), GP9 winch kill (high = winch on), GP10 WS2812 data (PIO, through U12), GP11 5 V power-good, GP14/GP15 CAN RX/TX (can2040 on the PIO, through U3), GP20/GP21 UART1 link to Pico B, GP22 leak excite, ADC0 12S pack, ADC1/ADC2 leak L/R. Its 3V3 pin feeds the board's +3V3 rail (keep the load under 300 mA). VSYS through D10."
			(at 8.89 -24.13 180)
			(layer "B.Fab")
			(hide yes)
			(uuid "ac8f2e86-a562-46ca-be6c-040c3aa760d1")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
				(justify mirror)
			)
		)
