	(footprint "dreams_v3:RaspberryPi_Pico_Socketed_THT"
		(layer "B.Cu")
		(uuid "f8e49e57-2ce2-425b-b13f-2f4b1d43cf15")
		(at 104 91)
		(descr "Raspberry Pi Pico / Pico 2, socketed on two 1x20 female headers (8.5 mm). Same pads, outline and 3D models as RaspberryPi_Pico_Common_THT, but the courtyard covers only the two socket rows and the USB end, so flat parts may sit under the module: keep them under ~7 mm tall. The micro-USB receptacle outline is on F.Fab only, so pads may sit under it. 3D: the 8.5 mm sockets with a Pico H seated in them. D.R.E.A.M.S V3.1, 2026-10-10.")
		(tags "module usb pcb antenna")
		(property "Reference" "U14"
			(at 8.69 -42.4 0)
			(unlocked yes)
			(layer "B.SilkS")
			(uuid "e6c846c8-142b-4dae-b83e-782ee6bc3573")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
				(justify left mirror)
			)
		)
		(property "Value" "Raspberry Pi Pico 2"
			(at 8.89 -52.07 180)
			(unlocked yes)
			(layer "B.Fab")
			(uuid "3f26853b-d6c0-487e-b3c4-4c4118d483a7")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
				(justify mirror)
			)
		)
		(property "Datasheet" ""
			(at 8.89 -24.13 180)
			(layer "B.Fab")
			(hide yes)
			(uuid "257cf144-6296-40a6-a059-6d4849c5b0e6")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
				(justify mirror)
			)
		)
		(property "Description" "Pico B, sensor MCU: Raspberry Pi Pico 2 (RP2350) on two 1x20 sockets under the carrier, C++ (Arduino-Pico or the Pico SDK), USB cable to the Pi. GP4/GP5 GPS (UART1), GP6 BMP390 INT, GP7 INA228 ALERT, GP8/GP9 BNO085 INT/RST, GP10/GP11 link to Pico A (PIO UART), GP12/GP13 I2C0 to the TCA9548A, GP14 mux reset, GP16/GP17 pod RS-485 (UART0, through U13), GP18 RS-485 DE, GP19/GP20 ADXL375 INT1/INT2. Its own 3V3 pin stays unconnected: Pico A's 3V3 feeds the board rail, and two regulator outputs are never tied. VSYS through D11."
			(at 8.89 -24.13 180)
			(layer "B.Fab")
			(hide yes)
			(uuid "aa8e3170-c85e-45a8-85ec-202929259840")
			(effects
				(font
					(size 1.27 1.27)
					(thickness 0.15)
				)
				(justify mirror)
			)
		)
