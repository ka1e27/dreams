		(uuid "4d9ab2f0-63c3-4953-b0a9-009ff493f7bb")
	)
	(text "BATTERY SENSE  -  56k/10k = 6.6x per M18 rail, 220k/13k = 17.9x on the 12S tap, plus a 1k series resistor from each tap into its ADC pin"
		(exclude_from_sim no)
		(at 15.00 279.18 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "9c03cf10-dd48-4bfb-bebe-bd90684e62e3")
	)
	(text "CAPACITORS  -  470uF bulk per M18 pack; 100nF ADC filters (V2 had none). The 12S tap cap is fitted off-board on the wiring, so there is no C3 here."
		(exclude_from_sim no)
		(at 15.00 314.80 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "495c3ee7-c085-4484-aada-46b95fd7b56b")
	)
	(text "CONNECTORS  -  all JST-XH, pins named per function"
		(exclude_from_sim no)
		(at 15.00 350.42 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "31ef2d25-6281-450d-9c3f-c10bc000b54b")
	)
	(text "M18 PACK INPUTS  -  XT60 + in-line Kelvin shunts.  Drive is sensed off-board: its pack never reaches this carrier."
		(exclude_from_sim no)
		(at 15.00 396.20 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "9f8b4505-97d9-46f7-8692-fdc74dd4299f")
	)
	(text "WINCH KILL PATH  -  high-side P-FET, fail-safe OFF, feeding the ESC on J16"
		(exclude_from_sim no)
		(at 15.00 436.90 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "80270991-ab34-4cd3-b804-218e0475c462")
	)
	(text "DECOUPLING  -  100nF per supply pin; C13 is the BNO085 internal-LDO cap (required)"
		(exclude_from_sim no)
		(at 15.00 475.06 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "ea90cb5b-7364-4791-803b-b63842d34eae")
	)
	(text "RAIL BULK + STEPPER MOTOR BULK"
		(exclude_from_sim no)
		(at 15.00 510.68 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "173608f8-d416-4731-a098-cbe9db286dc8")
	)
	(text "I2C PULL-UPS  -  4.7k pair on every used TCA9548A channel (a mux isolates them, so the upstream pair does not serve the channels)"
		(exclude_from_sim no)
		(at 15.00 546.30 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "5be61f54-8277-460f-a4b7-0143a2b48754")
	)
