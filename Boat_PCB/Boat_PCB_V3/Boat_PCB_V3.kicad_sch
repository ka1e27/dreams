	(text "10S POWER  (rev F, 2026-10-14)"
		(exclude_from_sim no)
		(at 261.62 198.12 0)
		(effects
			(font
				(size 2.0 2.0)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "8b07ff6e-67e0-5a3a-bc5e-52619548864b")
	)
	(text "Two 10S 10 Ah Li-ion packs in parallel make one 10S bus (30-42 V): drives, J13 and J14.\n+VELEC (10S, after R32) feeds three things:\n  the 5 V buck A2 through D12, diode-ORed with an optional 4S backup on J18 through D13 (+VLOGIC);\n  U15, +15V for the A4988's motor supply (it tops out at 35 V) and, through F1, the pod tether,\n  as on V3.1. 600 mA in all: the pod takes about 0.13 A, the stepper the rest.\nThe backup only keeps the Pi, Picos, sensors and radios up; the winch, stepper and pod need 10S.\nU10 reads the 10S electronics rail: VBUS near 0 V means the board is running on the backup."
		(exclude_from_sim no)
		(at 261.62 201.93 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "2fc0815e-8f75-58ca-99b8-8b2f2c31a160")
	)
