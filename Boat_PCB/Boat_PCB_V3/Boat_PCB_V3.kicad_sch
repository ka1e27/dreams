	(text "CARRIER  -  COMPUTE & BUS"
		(exclude_from_sim no)
		(at 15.00 25.00 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "e7a968da-1a84-4734-9872-55066c7ff1ad")
	)
	(text "CARRIER  -  ON-BOARD SENSORS"
		(exclude_from_sim no)
		(at 15.00 150.79 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "0ce35d16-87b2-4a86-bd07-d9d3d6af15d8")
	)
	(text "CARRIER  -  CURRENT SENSE  (M18 domains only; the 12S drive rail is voltage-only, and the VESCs already report per-motor current over CAN)"
		(exclude_from_sim no)
		(at 15.00 225.78 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3784d87f-ea58-42aa-bb99-6383576aa584")
	)
	(text "BATTERY SENSE  -  12S LiPo tap 220k/13k = 17.9x (50.4V), elec + winch 68k/10k = 7.8x (2.69 V at 21 V), plus a 1k series into each ADC pin.  R1/R2/R13 removed with the drive shunt: the 12S rail is voltage-only now, on J11."
		(exclude_from_sim no)
		(at 15.00 279.18 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "11483872-f0bf-4b77-a272-302685f040e8")
	)
	(text "CAPACITORS  -  470uF bulk per M18 pack; 100nF ADC filters (V2 had none). The 12S tap filter cap is C4 at the Teensy pin; J11 is JST-VH so no signal plug can mate with it."
		(exclude_from_sim no)
		(at 15.00 314.80 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "657928f8-1220-4f03-982e-aa9fb24aa967")
	)
	(text "CONNECTORS  -  JST-XH for signals, JST-VH for the 12S tap, XT60 for packs; J16 is female (switched output)"
		(exclude_from_sim no)
		(at 15.00 350.42 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3a34e5a8-dc90-4185-a76f-d4d91444ba44")
	)
	(text "M18 PACK INPUTS  -  XT60 (pin 1 = notched end = negative, per the XT60 convention) + in-line Kelvin shunts; the sense pins have their own nets (ELEC/WINCH_SHUNT_P/N).  Drive is sensed off-board: its pack never reaches this carrier."
		(exclude_from_sim no)
		(at 15.00 396.20 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "65bf40df-4f63-4dcd-a0f4-b79304f82903")
	)
	(text "WINCH KILL PATH  -  high-side P-FET, fail-safe OFF, feeding the ESC on J16"
		(exclude_from_sim no)
		(at 15.00 434.36 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1df169de-43f7-441f-b428-3feef7f0de69")
	)
	(text "DECOUPLING  -  100nF per supply pin; C13 is the BNO085 internal-LDO cap (required)"
		(exclude_from_sim no)
		(at 15.00 472.52 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "5c0010fc-5def-4cdd-b50d-1b079f740fcc")
	)
	(text "RAIL BULK + STEPPER MOTOR BULK"
		(exclude_from_sim no)
		(at 15.00 508.14 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "adfa4f49-cc42-4e7f-bd7b-11f29030fea5")
	)
	(text "I2C PULL-UPS  -  4.7k pair on every used TCA9548A channel except CH2, where the BMP390 breakout (U6) has its own (a mux isolates the channels, so the upstream pair does not serve them)"
		(exclude_from_sim no)
		(at 15.00 543.76 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "33363742-710a-4d08-819b-31d1551f1634")
	)
	(text "POD PCB  -  separate board, here for reference only.  Tether pin 2 carries the electronics pack voltage (M18, 15-21 V) through F1; the pod makes its own 5 V."
		(exclude_from_sim no)
		(at 15.00 579.38 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "e0ca0c2c-95f1-4742-abef-6850372ab2d6")
	)
