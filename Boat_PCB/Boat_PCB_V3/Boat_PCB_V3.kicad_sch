	(text "PI LINK  (rev E, 2026-10-13)"
		(exclude_from_sim no)
		(at 121.92 90.17 0)
		(effects
			(font
				(size 2.0 2.0)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "e3be85ec-d014-5c55-8797-904c64b98cbc")
	)
	(text "Pi UART0 (GPIO14 TX / GPIO15 RX, header pins 8 / 10) to Pico A GP17 / GP16 (its UART0 RX / TX).\nR66 / R67 (1k) in those lines stop either end back-powering the other through its pin.\nPico A's UART0 can't also take SBUS on GP1: run SBUS or this link on the PIO.\nPi GPIO23 / GPIO24 (header pins 16 / 18) high resets Pico A / B through Q3 / Q4, across SW1 / SW2.\nR64 / R65 hold them off while the Pi is off or booting: the Picos never need the Pi to run.\nPico B reaches the Pi through Pico A (LINK_A2B / LINK_B2A). Either Pico's USB still works too."
		(exclude_from_sim no)
		(at 121.92 93.98 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "d090b27b-4865-5744-8f56-b46d29c1c5e9")
	)
