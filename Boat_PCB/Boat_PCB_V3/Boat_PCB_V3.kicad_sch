	(text "TWO PICO 2s  (replaced the Teensy 4.1, 2026-10-13)"
		(exclude_from_sim no)
		(at 916.94 25.00 0)
		(effects
			(font
				(size 2.0 2.0)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "684452b6-9d83-552a-a02d-cd592f9287c8")
	)
	(text "Pico A (U1, next to the Pi header): control. CAN on the PIO (can2040), SBUS,\nwinch PWM + kill, stepper, WS2812, leak probes, 12S ADC.\nPico B (U14, here): sensors. TCA9548A I2C mux, GPS, pod RS-485.\nA UART link joins them: LINK_A2B / LINK_B2A.\nBoth sit socketed under the carrier, each with a USB cable to the Pi.\nVSYS from +5V through D10 / D11. Pico A's 3V3 pin is the board's +3V3 rail;\nPico B's 3V3 stays open, so two regulator outputs are never tied.\nSW1 / SW2 reset them: hold that Pico's BOOTSEL and tap for the UF2 bootloader."
		(exclude_from_sim no)
		(at 916.94 31.00 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "dcb1d340-4bd1-5be7-897a-1fc721965860")
	)
