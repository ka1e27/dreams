	)
	(text "CARRIER  -  CURRENT SENSE  (M18 domains only; the 12S drive rail is voltage-only, and the VESCs already report per-motor current over CAN)"
		(exclude_from_sim no)
		(at 15.00 225.78 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3784d87f-ea58-42aa-bb99-6383576aa584")
	)
	(text "BATTERY SENSE  -  12S LiPo tap 220k/13k = 17.9x (50.4V), elec + winch 56k/10k = 6.6x (21V), plus a 1k series into each ADC pin.  R1/R2/R13 removed with the drive shunt: the 12S rail is voltage-only now, on J11."
		(exclude_from_sim no)
		(at 15.00 279.18 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "11483872-f0bf-4b77-a272-302685f040e8")
	)
	(text "CAPACITORS  -  470uF bulk per M18 pack; 100nF ADC filters (V2 had none). The 12S tap cap is fitted off-board on the wiring, so there is no C3 here."
		(exclude_from_sim no)
		(at 15.00 314.80 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "657928f8-1220-4f03-982e-aa9fb24aa967")
	)
	(text "CONNECTORS  -  all JST-XH, pins named per function"
		(exclude_from_sim no)
		(at 15.00 350.42 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3a34e5a8-dc90-4185-a76f-d4d91444ba44")
	)
	(text "M18 PACK INPUTS  -  XT60 + in-line Kelvin shunts.  Drive is sensed off-board: its pack never reaches this carrier."
		(exclude_from_sim no)
		(at 15.00 396.20 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "65bf40df-4f63-4dcd-a0f4-b79304f82903")
	)
	(text "WINCH KILL PATH  -  high-side P-FET, fail-safe OFF, feeding the ESC on J16"
		(exclude_from_sim no)
		(at 15.00 434.36 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1df169de-43f7-441f-b428-3feef7f0de69")
	)
	(text "DECOUPLING  -  100nF per supply pin; C13 is the BNO085 internal-LDO cap (required)"
		(exclude_from_sim no)
		(at 15.00 472.52 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "5c0010fc-5def-4cdd-b50d-1b079f740fcc")
	)
