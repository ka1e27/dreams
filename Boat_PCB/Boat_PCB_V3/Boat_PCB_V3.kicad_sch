	(text "TETHER RS-485  (2026-09-25)  -  half duplex on Serial8 (TX8 pin 35, RX8 pin 34); pin 37 drives DE and ~RE together (Serial8.transmitterEnable(37)); R62 holds receive mode through reset; 120R termination at this end of the tether. RX idles high on the Teensy RX pull-up while transmitting."
		(exclude_from_sim no)
		(at 469.90 408.94 0)
		(effects
			(font
				(size 2.2 2.2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "4b3d2b4d-6cbf-41d3-96e5-58728e1dcbf4")
