		(uuid "caac910e-b9cb-5c4d-9756-c42904c20899")
	)
	(text "CAN CHAIN"
		(exclude_from_sim no)
		(at 381.00 22.86 0)
		(effects
			(font
				(size 2.0 2.0)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b2d90b38-db9d-5b47-b249-30c47e126ff4")
	)
	(text "TJA1051T/3 on two Pico pins (can2040 runs CAN on PIO).\nTwo connectors to daisy-chain the VESCs;\nJP1 switches in the 120 R terminator."
		(exclude_from_sim no)
		(at 381.00 26.67 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
