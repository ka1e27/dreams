		(uuid "e50669a7-3dd0-5756-beea-3e5e9cb1a616")
	)
	(text "PICO 2"
		(exclude_from_sim no)
		(at 185.42 129.54 0)
		(effects
			(font
				(size 2.0 2.0)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "95ddcd22-2f77-52d4-b8f6-b08669959659")
	)
	(text "Socketed Raspberry Pi Pico 2 (or Pico), C++ / Arduino-Pico.\nCAN on PIO (can2040), GPS on a PIO UART, RS-485 on UART0,\nRC on UART1, ESC PWM on GP14-16. USB cable to the Pi."
		(exclude_from_sim no)
		(at 185.42 133.35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "2f9830db-a327-5c36-b447-fdd02972a24b")
	)
	(text "GPS + I2C SENSORS"
		(exclude_from_sim no)
		(at 20.32 129.54 0)
		(effects
			(font
				(size 2.0 2.0)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f54553b4-2466-53f8-a57e-085d31a1641e")
	)
	(text "GPS UART on a PIO UART; its compass on I2C0.\nSHT41 breakout on the underside (hull air); Qwiic: TMP119 (water), spare.\nOne bus: 0x44, 0x48, compass 0x0D/0x0E/0x1E."
		(exclude_from_sim no)
		(at 20.32 133.35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "ea82afa9-4b43-58c1-95e8-81e5eeea4a26")
	)
	(text "POD TETHER"
