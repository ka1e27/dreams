				(bold yes)
			)
			(justify left top)
		)
		(uuid "3dc126a3-86cd-50fa-8b43-7062a28fcf31")
	)
	(text "RS-485 (THVD2410, half duplex) + 15 V from a D36V6F15.\nThe pod takes 12-21 V (24 V TVS at its input), never the\n42 V pack. GP19 high switches the pod off."
		(exclude_from_sim no)
		(at 368.30 133.35 0)
		(effects
