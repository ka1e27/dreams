	)
	(text "10S Li-ion pack (30-42 V) is the only battery.\nFuse, reverse-polarity P-FET, TVS, bulk cap;\npack voltage divider into ADC0 (x 0.0698)."
		(exclude_from_sim no)
		(at 20.32 26.67 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "5a3e7e17-b3d7-5c80-9faf-a272541128fa")
	)
	(text "5 V"
		(exclude_from_sim no)
		(at 185.42 22.86 0)
		(effects
			(font
				(size 2.0 2.0)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7bcc8679-88f5-5c7d-8bba-d7590e952695")
	)
	(text "Pololu D36V50F5: 5.5-50 V in, 5.5 A.\nFeeds the Pi 5, Pico VSYS (through D3),\nGPS, RC receiver and the CAN transceiver."
		(exclude_from_sim no)
		(at 185.42 26.67 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "8ac97d85-dfa9-59c3-8fcc-54d89c7d86cb")
	)
	(text "RASPBERRY PI 5"
		(exclude_from_sim no)
		(at 297.18 22.86 0)
		(effects
			(font
				(size 2.0 2.0)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "09aec09d-1252-5a04-8be4-39b2454b9f18")
	)
	(text "Face down on the socket and its 4 standoff holes.\nPower only: 5 V on pins 2 and 4.\nData to the Pico over USB."
		(exclude_from_sim no)
		(at 297.18 26.67 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
