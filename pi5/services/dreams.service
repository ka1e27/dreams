[Unit]
Description=D.R.E.A.M.S boat stack — uploads Boat Pico firmware, then serves the dashboard/command center
# Wait for the network so the dashboard is reachable; USB enumerates separately.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ---- EDIT THESE for your Pi ----
# The user must be in the dialout (serial) and video (camera) groups:
#   sudo usermod -aG dialout,video pi   &&   reboot
User=pi
WorkingDirectory=/home/pi/COE 2 Autonomous Boat
ExecStart=/home/pi/dreams-venv/bin/python run_hardware.py
# --------------------------------

# Give USB devices (/dev/ttyACM0, /dev/video0) a moment to enumerate at boot
# before run_hardware.py deploys firmware and opens the serial port.
ExecStartPre=/bin/sleep 5

# run_hardware.py uploads firmware/boat-pico/*.py to the Pico and resets it on
# startup (serial.deploy_on_start in config.yaml), so no separate deploy step
# is needed here.

Restart=on-failure
RestartSec=5

# Optional: set an API key for the dashboard/API (otherwise it's open on the LAN)
# Environment=BOAT_API_KEY=change-me

[Install]
WantedBy=multi-user.target
