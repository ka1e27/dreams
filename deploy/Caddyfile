# Caddy reverse proxy for the boat API and dashboard.
#
# Caddy automatically provisions and renews HTTPS certificates via Let's Encrypt.
# Replace "boat.yourdomain.com" with your actual domain pointed at the Pi 5's
# public IP (via the SIM7600 cellular modem).
#
# Install: sudo apt install caddy
# Run:     sudo caddy run --config /path/to/Caddyfile
#
# For local/dev use without a domain, replace the domain line with:
#   :443 {
#     tls internal
#     ...
#   }

boat.yourdomain.com {
    # API and WebSocket endpoints — proxy to FastAPI on localhost:8080
    handle /api/* {
        reverse_proxy localhost:8080
    }

    handle /ws/* {
        reverse_proxy localhost:8080
    }

    # Dashboard static files — serve the built React app
    handle {
        root * /home/pi/boat/dashboard/dist
        file_server
        try_files {path} /index.html
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Request size limit (prevent abuse)
    request_body {
        max_size 1MB
    }

    log {
        output file /var/log/caddy/boat.log
        format json
    }
}
